# ─────────────────────────────────────────────────────────────
# fletway-backend — variables de entorno (ejemplo)
# Copiar a .env y completar. .env está en .gitignore.
# ─────────────────────────────────────────────────────────────

# --- HTTP ---
APP_ENV=development                 # development | staging | production
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=20s

# --- Base de datos (Postgres de Supabase, acceso directo con pgx) ---
# Connection string del proyecto dbFletway. Usar el pooler (puerto 6543, mode transaction)
# o la conexión directa (5432) según el entorno.
DATABASE_URL=postgres://postgres.gfadryudaaqyxnkrpbex:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h

# --- Supabase (API / Auth) ---
SUPABASE_URL=https://gfadryudaaqyxnkrpbex.supabase.co
SUPABASE_ANON_KEY=                  # clave anon pública (para flujos que la requieran)
# NUNCA commitear la service_role. El backend NO la usa en operación normal (D-02):
# solo para tareas administrativas puntuales y bajo confirmación.
SUPABASE_SERVICE_ROLE_KEY=

# --- Verificación de JWT (D-04 — confirmar esquema del proyecto) ---
# Opción JWKS (proyectos nuevos):
SUPABASE_JWKS_URL=https://gfadryudaaqyxnkrpbex.supabase.co/auth/v1/.well-known/jwks.json
# Opción HS256 legacy (fallback): el JWT secret del proyecto.
SUPABASE_JWT_SECRET=
JWT_EXPECTED_AUDIENCE=authenticated
JWT_EXPECTED_ISSUER=https://gfadryudaaqyxnkrpbex.supabase.co/auth/v1

# --- Workers async (RNF-02 / D-06) ---
ASYNC_WORKERS=4
ASYNC_QUEUE_SIZE=256

# --- Pasarela de pagos (RI-03 / D-09 — sin decidir) ---
PAYMENTS_PROVIDER=                  # mercadopago | stripe
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=

# --- Observabilidad ---
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | text

# --- MCP de Supabase (para Claude Code, ver .mcp.json y .claude/mcp-notes.md) ---
# Personal access token de Supabase. El .mcp.json arranca el server en --read-only.
SUPABASE_ACCESS_TOKEN=
