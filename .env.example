# ─────────────────────────────────────────────────────────────
# fletway-backend — variables de entorno (ejemplo)
# Copiar a .env y completar. .env está en .gitignore.
# ─────────────────────────────────────────────────────────────

# --- HTTP ---
APP_ENV=development                 # development | staging | production
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=20s

# --- Base de datos (Postgres de Supabase, acceso directo con pgx) ---
# Connection string del proyecto dbFletway. Usar el pooler (puerto 6543, mode transaction)
# o la conexión directa (5432) según el entorno.
# Local (esta etapa, D-16): la que muestra `supabase status`, por defecto:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Producción (fuera de esta etapa): pooler de Supabase en modo transacción (6543). pgx necesita
# desactivar las sentencias preparadas con `default_query_exec_mode=simple_protocol`.
DATABASE_URL=postgres://postgres.gfadryudaaqyxnkrpbex:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?default_query_exec_mode=simple_protocol
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h

# --- Supabase (API / Auth) ---
# Local: http://127.0.0.1:54321 (`supabase status`).
SUPABASE_URL=https://gfadryudaaqyxnkrpbex.supabase.co
# Clave pública (publishable) del proyecto. Obligatoria: el backend la manda como
# apikey al pedir URLs firmadas de Storage (D-19). En local: `supabase status`.
SUPABASE_ANON_KEY=
# NUNCA commitear la service_role. El backend NO la usa en operación normal (D-02):
# solo para tareas administrativas puntuales y bajo confirmación.
SUPABASE_SERVICE_ROLE_KEY=

# --- Verificación de JWT (D-04: Supabase Auth, ES256 vía JWKS, sin HS256) ---
# Si se dejan vacías, se derivan de SUPABASE_URL:
#   SUPABASE_JWKS_URL   = <SUPABASE_URL>/auth/v1/.well-known/jwks.json
#   JWT_EXPECTED_ISSUER = <SUPABASE_URL>/auth/v1
# Coordenadas y autocompletado de direcciones (D-20, D-35): "geoapify" (datos reales) o
# "aproximado" (sólo desarrollo, sin API key). En producción el backend no arranca si no es
# "geoapify".
GEOCODIFICADOR_PROVEEDOR=geoapify
# Distancia, duración y recorrido del trayecto (D-24, D-35): "geoapify" (calles reales) o
# "aproximado" (línea recta x 1,3 a 30 km/h, sólo desarrollo). En producción hace falta "geoapify".
RUTEO_PROVEEDOR=geoapify
# API key de Geoapify (D-35). Plan gratis, sin tarjeta: https://www.geoapify.com
GEOAPIFY_API_KEY=
SUPABASE_JWKS_URL=
JWT_EXPECTED_AUDIENCE=authenticated
JWT_EXPECTED_ISSUER=

# --- Tests de integración (D-12, D-16) ---
# Connection string de la base LOCAL de Supabase (`supabase status`). Nunca dbFletway.
# Si está vacía, los tests de integración se saltean.
TEST_DATABASE_URL=

# --- Workers async (RNF-02 / D-06) ---
ASYNC_WORKERS=4
ASYNC_QUEUE_SIZE=256

# --- Pasarela de pagos (RI-03 / D-09 — sin decidir) ---
PAYMENTS_PROVIDER=                  # mercadopago | stripe
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=

# --- Observabilidad ---
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | text

# --- MCP de Supabase (para Claude Code, ver .mcp.json y .claude/mcp-notes.md) ---
# Personal access token de Supabase. El .mcp.json arranca el server en --read-only.
SUPABASE_ACCESS_TOKEN=
